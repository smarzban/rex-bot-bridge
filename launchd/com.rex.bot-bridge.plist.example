<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example launchd agent for rex-bot-bridge. Not installed automatically.
  1. Replace /Users/YOU with your home directory and REPO with the checkout path.
  2. npm run build && node dist/cli/bridge.js token
  3. cp launchd/com.rex.bot-bridge.plist.example ~/Library/LaunchAgents/com.rex.bot-bridge.plist
  4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rex.bot-bridge.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rex.bot-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/REPO/dist/cli/bridge.js</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/REPO</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOU</string>
    <!-- The rex binary lives inside the Rex app bundle (path has spaces). -->
    <key>REX_BIN</key>
    <string>/Users/YOU/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex</string>
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/Users/YOU/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>REX_BRIDGE_HOST</key>
    <string>127.0.0.1</string>
    <key>REX_BRIDGE_PORT</key>
    <string>7400</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/rex-bot-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/rex-bot-bridge.log</string>
</dict>
</plist>
