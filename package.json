{
  "name": "rex-grokbot-bridge",
  "version": "0.7.3",
  "description": "MCP server and webhook bridge for macOS: lets Grok Bot, over Tailscale, see and drive the coding agents (Claude Code, Codex, Pi) in your Rex terminal, and get pinged when they finish or get stuck.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "grok",
    "grok-bot",
    "rex",
    "rex-terminal",
    "terminal",
    "coding-agents",
    "ai-agents",
    "claude-code",
    "codex",
    "tailscale",
    "webhook",
    "macos",
    "launchd",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Saeed Marzban",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarzban/rex-grokbot-bridge.git"
  },
  "homepage": "https://github.com/smarzban/rex-grokbot-bridge#readme",
  "bugs": {
    "url": "https://github.com/smarzban/rex-grokbot-bridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "rex-grokbot": "dist/cli/rex-grokbot.js"
  },
  "files": [
    "dist",
    "lua",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/rex-grokbot.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "prepare": "npm run build",
    "start": "node dist/cli/rex-grokbot.js serve",
    "dev": "tsx src/cli/rex-grokbot.ts serve",
    "e2e": "node scripts/e2e.mjs",
    "e2e:paste": "node scripts/e2e-paste.mjs",
    "e2e:sandbox": "node scripts/e2e-sandbox.mjs",
    "docs:commands": "tsx scripts/gen-reference-commands.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
